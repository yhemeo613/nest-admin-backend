# ============ 应用 ============
NODE_ENV=development
APP_PORT=3000
# 允许跨域来源，逗号分隔；留空表示全部允许（仅开发环境建议）
CORS_ORIGIN=
LOG_LEVEL=debug

# ============ 数据库 ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_admin
REDIS_URL=redis://localhost:6379

# ============ JWT ============
# 生产环境必须替换为高强度随机串（>=32 位）
JWT_ACCESS_SECRET=please-change-me-access-secret-32b
JWT_REFRESH_SECRET=please-change-me-refresh-secret-32b
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=604800

# ============ 限流 ============
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

