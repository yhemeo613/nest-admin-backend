{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Nest App",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@nestperm/server", "run", "start:debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "autoAttachChildProcesses": true,
      "envFile": "${workspaceFolder}/apps/server/.env.development",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Jest 当前文件",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@nestperm/server", "exec", "jest", "--runInBand", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "envFile": "${workspaceFolder}/apps/server/.env.test",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Jest e2e",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nestperm/server",
        "exec",
        "jest",
        "--runInBand",
        "--config",
        "test/jest-e2e.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/apps/server/.env.test",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach: 9229",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
