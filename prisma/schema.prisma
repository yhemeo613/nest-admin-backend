generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 通用枚举 ====================

enum Status {
  ENABLED
  DISABLED
}

// 数据权限范围
enum DataScope {
  ALL               // 全部数据
  DEPT_AND_CHILDREN // 本部门及以下
  DEPT              // 仅本部门
  SELF              // 仅本人
  CUSTOM            // 自定义部门集合（sys_role_dept）
}

// 权限点类型：目录 / 菜单 / 按钮 / 接口
enum PermType {
  DIR
  MENU
  BUTTON
  API
}

// ==================== 权限中枢 ====================

model SysUser {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String // argon2 哈希
  nickname  String
  email     String?
  phone     String?
  avatar    String?
  deptId    String?   @map("dept_id")
  isSuper   Boolean   @default(false) @map("is_super")
  status    Status    @default(ENABLED)
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  dept  SysDept?      @relation(fields: [deptId], references: [id])
  roles SysUserRole[]

  @@index([deptId])
  @@map("sys_user")
}

model SysRole {
  id        String    @id @default(uuid())
  code      String    @unique // 角色编码，如 admin
  name      String
  dataScope DataScope @default(SELF) @map("data_scope")
  status    Status    @default(ENABLED)
  sort      Int       @default(0)
  remark    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users SysUserRole[]
  perms SysRolePermission[]
  depts SysRoleDept[]

  @@map("sys_role")
}

model SysPermission {
  id        String   @id @default(uuid())
  parentId  String?  @map("parent_id")
  name      String // 显示名：用户管理 / 新增按钮
  code      String   @unique // 权限码：system:user:create
  type      PermType
  path      String? // 前端路由（menu 时）
  icon      String?
  sort      Int      @default(0)
  status    Status   @default(ENABLED)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   SysPermission?       @relation("PermTree", fields: [parentId], references: [id])
  children SysPermission[]      @relation("PermTree")
  roles    SysRolePermission[]

  @@index([parentId])
  @@map("sys_permission")
}

model SysDept {
  id        String   @id @default(uuid())
  parentId  String?  @map("parent_id")
  // 物化路径，形如 ",0,1,2,"，查子树用 contains 免递归
  ancestors String   @default(",")
  name      String
  sort      Int      @default(0)
  status    Status   @default(ENABLED)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   SysDept?      @relation("DeptTree", fields: [parentId], references: [id])
  children SysDept[]     @relation("DeptTree")
  users    SysUser[]
  roles    SysRoleDept[]

  @@index([parentId])
  @@index([ancestors])
  @@map("sys_dept")
}

model SysUserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user SysUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("sys_user_role")
}

model SysRolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       SysRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SysPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("sys_role_permission")
}

// CUSTOM 数据范围时角色可见的部门集合
model SysRoleDept {
  roleId String @map("role_id")
  deptId String @map("dept_id")

  role SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  dept SysDept @relation(fields: [deptId], references: [id], onDelete: Cascade)

  @@id([roleId, deptId])
  @@map("sys_role_dept")
}

// ==================== AI 审计 ====================

model AiCallLog {
  id               String   @id @default(uuid())
  traceId          String?  @map("trace_id")
  userId           String?  @map("user_id")
  provider         String
  model            String
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  costEstimate     Decimal? @map("cost_estimate") @db.Decimal(12, 6)
  latencyMs        Int      @default(0) @map("latency_ms")
  status           String // success / error / fallback
  errorMsg         String?  @map("error_msg")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("ai_call_log")
}

// ==================== AI 供应商/模型配置（用户可自定义，参考 CC Switch） ====================

model AiProvider {
  id        String    @id @default(uuid())
  name      String
  protocol  String // OPENAI_COMPAT / OLLAMA（上游协议格式，可扩展）
  baseUrl   String    @map("base_url")
  apiKey    String?   @map("api_key")
  remark    String?
  enabled   Boolean   @default(true)
  sort      Int       @default(0)
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  models AiModel[]

  @@map("ai_provider")
}

model AiModel {
  id            String   @id @default(uuid())
  providerId    String   @map("provider_id")
  name          String // 模型 ID（请求上游时使用）
  label         String? // 显示名
  maxOutput     Int?     @map("max_output") // 最大输出 tokens（覆盖全局 AI_MAX_TOKENS）
  contextWindow Int?     @map("context_window") // 上下文窗口 tokens（仅展示/提示用）
  enabled       Boolean  @default(true)
  isDefault     Boolean  @default(false) @map("is_default")
  sort          Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("ai_model")
}

// ==================== 站内通知（真实接口驱动） ====================

model SysNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id") // 接收者
  type      String // NOTICE 系统通知 / MESSAGE 消息 / TODO 待办
  title     String
  content   String?   @map("content")
  link      String?   @map("link") // 可选跳转路由
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("sys_notification")
}
