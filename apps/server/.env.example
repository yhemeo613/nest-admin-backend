# ============ 应用 ============
NODE_ENV=development
APP_PORT=3000
# 允许跨域来源，逗号分隔；留空表示全部允许（仅开发环境建议）
CORS_ORIGIN=
LOG_LEVEL=debug

# ============ 数据库 ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_admin
REDIS_URL=redis://localhost:6379

# ============ JWT ============
# 生产环境必须替换为高强度随机串（>=32 位）
JWT_ACCESS_SECRET=please-change-me-access-secret-32b
JWT_REFRESH_SECRET=please-change-me-refresh-secret-32b
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=604800

# ============ 限流 ============
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100


# ============ 代码评审（NestReview） ============
# 评审域密文密钥（模型 apiKey/仓库凭证），32+ 字符；缺省派生自 JWT_ACCESS_SECRET
REVIEW_CRYPTO_KEY=
# ocr 二进制路径（默认取 PATH 中的 ocr；npm 包：@alibaba-group/open-code-review）
OCR_BIN_PATH=ocr
# 评审工作区根目录（相对 apps/server，Docker 需挂卷）
REVIEW_WORKSPACE_DIR=workspaces/review
# 单任务超时（毫秒，默认 30 分钟）
REVIEW_TASK_TIMEOUT_MS=1800000
# 队列 worker 并发（视 LLM 配额调整）
REVIEW_WORKER_CONCURRENCY=1
