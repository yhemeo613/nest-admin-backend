generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 通用枚举 ====================

enum Status {
  ENABLED
  DISABLED
}

// 数据权限范围
enum DataScope {
  ALL               // 全部数据
  DEPT_AND_CHILDREN // 本部门及以下
  DEPT              // 仅本部门
  SELF              // 仅本人
  CUSTOM            // 自定义部门集合（sys_role_dept）
}

// 权限点类型：目录 / 菜单 / 按钮 / 接口
enum PermType {
  DIR
  MENU
  BUTTON
  API
}

// ==================== 权限中枢 ====================

model SysUser {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String // argon2 哈希
  nickname  String
  email     String?
  phone     String?
  avatar    String?
  deptId    String?   @map("dept_id")
  isSuper   Boolean   @default(false) @map("is_super")
  status    Status    @default(ENABLED)
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  dept  SysDept?      @relation(fields: [deptId], references: [id])
  roles SysUserRole[]

  @@index([deptId])
  @@map("sys_user")
}

model SysRole {
  id        String    @id @default(uuid())
  code      String    @unique // 角色编码，如 admin
  name      String
  dataScope DataScope @default(SELF) @map("data_scope")
  status    Status    @default(ENABLED)
  sort      Int       @default(0)
  remark    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users SysUserRole[]
  perms SysRolePermission[]
  depts SysRoleDept[]

  @@map("sys_role")
}

model SysPermission {
  id        String   @id @default(uuid())
  parentId  String?  @map("parent_id")
  name      String // 显示名：用户管理 / 新增按钮
  code      String   @unique // 权限码：system:user:create
  type      PermType
  path      String? // 前端路由（menu 时）
  icon      String?
  sort      Int      @default(0)
  status    Status   @default(ENABLED)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   SysPermission?       @relation("PermTree", fields: [parentId], references: [id])
  children SysPermission[]      @relation("PermTree")
  roles    SysRolePermission[]

  @@index([parentId])
  @@map("sys_permission")
}

model SysDept {
  id        String   @id @default(uuid())
  parentId  String?  @map("parent_id")
  // 物化路径，形如 ",0,1,2,"，查子树用 contains 免递归
  ancestors String   @default(",")
  name      String
  sort      Int      @default(0)
  status    Status   @default(ENABLED)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   SysDept?      @relation("DeptTree", fields: [parentId], references: [id])
  children SysDept[]     @relation("DeptTree")
  users    SysUser[]
  roles    SysRoleDept[]

  @@index([parentId])
  @@index([ancestors])
  @@map("sys_dept")
}

model SysUserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user SysUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("sys_user_role")
}

model SysRolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       SysRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SysPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("sys_role_permission")
}

// CUSTOM 数据范围时角色可见的部门集合
model SysRoleDept {
  roleId String @map("role_id")
  deptId String @map("dept_id")

  role SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  dept SysDept @relation(fields: [deptId], references: [id], onDelete: Cascade)

  @@id([roleId, deptId])
  @@map("sys_role_dept")
}

// ==================== AI 审计 ====================

model AiCallLog {
  id               String   @id @default(uuid())
  traceId          String?  @map("trace_id")
  userId           String?  @map("user_id")
  provider         String
  model            String
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  costEstimate     Decimal? @map("cost_estimate") @db.Decimal(12, 6)
  latencyMs        Int      @default(0) @map("latency_ms")
  status           String // success / error / fallback
  errorMsg         String?  @map("error_msg")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("ai_call_log")
}

// ==================== AI 供应商/模型配置（用户可自定义，参考 CC Switch） ====================

model AiProvider {
  id        String    @id @default(uuid())
  name      String
  protocol  String // OPENAI_COMPAT / OLLAMA（上游协议格式，可扩展）
  baseUrl   String    @map("base_url")
  apiKey    String?   @map("api_key")
  remark    String?
  enabled   Boolean   @default(true)
  sort      Int       @default(0)
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  models AiModel[]

  @@map("ai_provider")
}

model AiModel {
  id            String   @id @default(uuid())
  providerId    String   @map("provider_id")
  name          String // 模型 ID（请求上游时使用）
  label         String? // 显示名
  maxOutput     Int?     @map("max_output") // 最大输出 tokens（覆盖全局 AI_MAX_TOKENS）
  contextWindow Int?     @map("context_window") // 上下文窗口 tokens（仅展示/提示用）
  enabled       Boolean  @default(true)
  isDefault     Boolean  @default(false) @map("is_default")
  sort          Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("ai_model")
}

// ==================== SaaS 多租户（客服系统地基） ====================

model Tenant {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique // 租户编码（全局唯一，小写字母/数字/中划线）
  contactName  String?   @map("contact_name")
  contactEmail String?   @map("contact_email")
  ownerId      String?   @map("owner_id") // 自助注册归属的管理员账号（租户管理员身份锚点）
  status       Status    @default(ENABLED)
  remark       String?
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  apiKeys       TenantApiKey[]
  conversations TenantConversation[]
  kbs           SaasKb[]

  @@index([status])
  @@index([ownerId])
  @@map("tenant")
}

// 租户接入凭证：明文仅创建时返回一次，库中只存 sha256
model TenantApiKey {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  name       String
  keyHash    String    @unique @map("key_hash") // sha256(明文)
  keyPrefix  String    @map("key_prefix") // 展示用，如 sk-abc123
  status     Status    @default(ENABLED)
  lastUsedAt DateTime? @map("last_used_at")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_api_key")
}

// 访客会话（挂件/API 接入的对话会话）
model TenantConversation {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  visitorId    String   @map("visitor_id") // 访客侧持久标识（挂件生成）
  title        String? // 首条消息截断
  status       String   @default("OPEN") // OPEN / CLOSED
  messageCount Int      @default(0) @map("message_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages TenantMessage[]

  @@index([tenantId, updatedAt])
  @@index([tenantId, visitorId])
  @@map("tenant_conversation")
}

// 会话消息（tenantId 冗余一份，便于行级租户过滤）
model TenantMessage {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  conversationId   String   @map("conversation_id")
  role             String // user / assistant
  content          String   @db.Text
  model            String? // assistant 消息命中的模型
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  createdAt        DateTime @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  conversation TenantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@map("tenant_message")
}

// ==================== SaaS 知识库（挂件问答与 SEO 页的内容源） ====================

enum KbArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// 知识库（租户可多库：售后政策库、产品手册库…）
model SaasKb {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  sort        Int      @default(0)
  status      Status   @default(ENABLED)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles SaasKbArticle[]
  tags     SaasKbTag[]

  @@index([tenantId])
  @@map("saas_kb")
}

// 文章：同时是 C 端 SEO 页与挂件检索的内容单元
model SaasKbArticle {
  id             String         @id @default(uuid())
  kbId           String         @map("kb_id")
  tenantId       String         @map("tenant_id") // 冗余租户维度，便于行级过滤
  title          String
  slug           String // URL 友好标识（同库唯一）
  content        String         @db.Text // Markdown
  status         KbArticleStatus @default(DRAFT)
  seoTitle       String?        @map("seo_title") // SEO 页 <title>，缺省回填 title
  seoDescription String?        @map("seo_description") // meta description，缺省取正文摘要
  publishedAt    DateTime?      @map("published_at")
  viewCount      Int            @default(0) @map("view_count") // SEO 页浏览计数
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  kb   SaasKb             @relation(fields: [kbId], references: [id], onDelete: Cascade)
  tags SaasKbArticleTag[]

  @@unique([kbId, slug])
  @@index([tenantId, status])
  @@index([kbId, status])
  @@map("saas_kb_article")
}

// 标签（租户内按库唯一）
model SaasKbTag {
  id        String   @id @default(uuid())
  kbId      String   @map("kb_id")
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  kb       SaasKb             @relation(fields: [kbId], references: [id], onDelete: Cascade)
  articles SaasKbArticleTag[]

  @@unique([kbId, name])
  @@index([tenantId])
  @@map("saas_kb_tag")
}

// 文章-标签多对多
model SaasKbArticleTag {
  articleId String @map("article_id")
  tagId     String @map("tag_id")

  article SaasKbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     SaasKbTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("saas_kb_article_tag")
}

// ==================== 站内通知（真实接口驱动） ====================

model SysNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id") // 接收者
  type      String // NOTICE 系统通知 / MESSAGE 消息 / TODO 待办
  title     String
  content   String?   @map("content")
  link      String?   @map("link") // 可选跳转路由
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("sys_notification")
}
