{
  "name": "nest-admin-workspace",
  "version": "1.0.0",
  "description": "NestJS 权限中枢 monorepo：apps/server（后端）+ apps/web（管理端）+ packages/contracts（前后端共享契约）",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "pnpm --filter @nestperm/server dev",
    "dev:web": "pnpm --filter @nestperm/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "prisma:generate": "turbo run prisma:generate",
    "prisma:migrate": "pnpm --filter @nestperm/server prisma:migrate",
    "prisma:migrate:test": "pnpm --filter @nestperm/server prisma:migrate:test",
    "prisma:deploy": "pnpm --filter @nestperm/server prisma:deploy",
    "prisma:seed": "turbo run prisma:seed",
    "db:init": "turbo run db:init",
    "check:circular": "pnpm --filter @nestperm/server check:circular",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0"
  },
  "lint-staged": {
    "{turbo.json,package.json,pnpm-workspace.yaml,*.md,*.yml,*.yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "vue": "3.5.22",
      "@vue/reactivity": "3.5.22",
      "@vue/runtime-core": "3.5.22",
      "@vue/runtime-dom": "3.5.22",
      "@vue/shared": "3.5.22",
      "element-plus": "2.11.4",
      "pinia": "3.0.3",
      "vue-router": "4.5.1",
      "axios": "1.12.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild"
    ]
  }
}
