@host = http://localhost:3000/api/v1
@accessToken = paste-your-access-token-here
@demoApiKey = sk-local-demo-001

### 租户分页列表（需要 saas:tenant:list 权限）
GET {{host}}/saas/tenants?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### 新增租户（需要 saas:tenant:create 权限）
POST {{host}}/saas/tenants
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "星辰电商",
  "code": "xingchen",
  "contactName": "张三",
  "contactEmail": "support@xingchen.example.com",
  "remark": "http 用例创建"
}

### 修改租户（需要 saas:tenant:update 权限）
PUT {{host}}/saas/tenants/some-tenant-id
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "星辰电商（改名）",
  "contactName": "李四",
  "status": "ENABLED"
}

### 删除租户（软删除，API Key 连带失效；需要 saas:tenant:delete 权限）
DELETE {{host}}/saas/tenants/some-tenant-id
Authorization: Bearer {{accessToken}}

### 租户的 API Key 列表（需要 saas:apikey:list 权限，不含明文）
GET {{host}}/saas/tenants/seed-tenant-demo/api-keys
Authorization: Bearer {{accessToken}}

### 创建 API Key（需要 saas:apikey:create 权限；plaintext 只在本次响应返回）
POST {{host}}/saas/tenants/seed-tenant-demo/api-keys
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "官网挂件"
}

### 删除 API Key（软删除立即失效；需要 saas:apikey:delete 权限）
DELETE {{host}}/saas/api-keys/some-apikey-id
Authorization: Bearer {{accessToken}}

### 访客 AI 对话（SSE 流式，X-Api-Key 鉴权，免 JWT，限流 30 次/分钟）
# 首帧回传 conversationId；续聊时带上该 ID；结束帧含 usage/model
POST {{host}}/saas/visitor/chat/stream
X-Api-Key: {{demoApiKey}}
Content-Type: application/json
Accept: text/event-stream

{
  "visitorId": "v-demo-001",
  "message": "你好，请问你们的退货政策是什么？"
}

### 访客续聊（带上上一步返回的 conversationId）
POST {{host}}/saas/visitor/chat/stream
X-Api-Key: {{demoApiKey}}
Content-Type: application/json
Accept: text/event-stream

{
  "visitorId": "v-demo-001",
  "conversationId": "some-conversation-id",
  "message": "那运费谁承担？"
}

### 访客会话分页列表（需要 saas:conversation:list 权限）
GET {{host}}/saas/conversations?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### 会话详情（含全部消息；需要 saas:conversation:detail 权限）
GET {{host}}/saas/conversations/some-conversation-id
Authorization: Bearer {{accessToken}}

### 知识库分页列表（需要 saas:kb:list 权限）
GET {{host}}/saas/kbs?page=1&pageSize=10
Authorization: Bearer {{accessToken}}

### 新增知识库（需要 saas:kb:create 权限）
POST {{host}}/saas/kbs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "tenantId": "seed-tenant-demo",
  "name": "售后政策库",
  "description": "退货/换货/发票等常见问题"
}

### 库内文章列表（需要 saas:kb:article:list 权限）
GET {{host}}/saas/kbs/some-kb-id/articles?page=1&pageSize=10
Authorization: Bearer {{accessToken}}

### 新增文章（需要 saas:kb:article:create 权限；二级标题为问句可获搜索富摘要）
POST {{host}}/saas/kbs/some-kb-id/articles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "如何申请退货",
  "slug": "return-policy",
  "content": "## 如何申请退货？\n\n收货后 7 天内联系在线客服申请，通过后按指引寄回。\n\n## 退货运费谁承担？\n\n非质量问题由买家承担运费，质量问题由我们承担。",
  "status": "PUBLISHED",
  "seoDescription": "星辰电商退货政策：7 天无理由退货流程与运费说明。"
}

### 库内标签列表（需要 saas:kb:tag:list 权限）
GET {{host}}/saas/kbs/some-kb-id/tags
Authorization: Bearer {{accessToken}}

### 新增标签（需要 saas:kb:tag:create 权限）
POST {{host}}/saas/kbs/some-kb-id/tags
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "退货" }

### C 端帮助中心首页（公开，服务端直出可 SEO）
GET http://localhost:3000/help/demo-shop

### C 端帮助中心文章页（公开，含 JSON-LD）
GET http://localhost:3000/help/demo-shop/return-policy

### sitemap（公开）
GET http://localhost:3000/help/demo-shop/sitemap.xml

### 挂件脚本（公开，宿主网站引入）
GET http://localhost:3000/widget.js?k={{demoApiKey}}

### 挂件容器页（公开，iframe 加载）
GET http://localhost:3000/chat-widget?k={{demoApiKey}}

### 挂件相关文章推荐（公开，X-Api-Key）
POST {{host}}/saas/visitor/articles
X-Api-Key: {{demoApiKey}}
Content-Type: application/json

{ "q": "退货" }

### 修改自己的资料（登录即可）
PUT {{host}}/auth/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "nickname": "系统管理员" }

### 修改自己的密码（登录即可，成功后强制重新登录）
PUT {{host}}/auth/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "oldPassword": "Admin@123", "newPassword": "Admin@1234" }

### 租户自助注册（Public，开通租户+管理员账号，限流 3 次/分钟）
POST {{host}}/auth/register
Content-Type: application/json

{
  "tenantName": "体验商店",
  "tenantCode": "tiyan-shop",
  "username": "tiyanboss",
  "password": "Tiyan@12345",
  "email": "boss@tiyan.example.com"
}
