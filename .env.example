# ============ 应用 ============
NODE_ENV=development
APP_PORT=3000
# 允许跨域来源，逗号分隔；留空表示全部允许（仅开发环境建议）
CORS_ORIGIN=
LOG_LEVEL=debug

# ============ 数据库 ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_admin
REDIS_URL=redis://localhost:6379

# ============ JWT ============
# 生产环境必须替换为高强度随机串（>=32 位）
JWT_ACCESS_SECRET=please-change-me-access-secret-32b
JWT_REFRESH_SECRET=please-change-me-refresh-secret-32b
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=604800

# ============ 限流 ============
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ============ AI ============
# 可选：mock(本地模拟，无需密钥) / openai / deepseek / qwen / zhipu / moonshot / mimo(小米) / ollama
AI_PROVIDER=mock
AI_API_KEY=
# 留空则使用厂商默认地址
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
# 小米 MiMo 示例（flash 快、pro 强，互为主备）：
# AI_PROVIDER=mimo
# AI_API_KEY=tp-xxx
# AI_MODEL=mimo-v2.6-flash
# AI_FALLBACK_MODEL=mimo-v2.6-pro
# 向量化模型（留空按厂商默认：openai 系 text-embedding-3-small，ollama nomic-embed-text）
AI_EMBEDDING_MODEL=
# 备用模型：主模型失败时自动降级重试一次
AI_FALLBACK_MODEL=
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=2048
